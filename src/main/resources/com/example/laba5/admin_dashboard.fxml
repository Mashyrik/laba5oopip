<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.AdminDashboardController"
            stylesheets="@styles.css">

    <top>
        <VBox styleClass="header">
            <Label text="Панель администратора" styleClass="header-title"/>
            <Label fx:id="welcomeLabel" text="Добро пожаловать!" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40;">
            <Label text="Функции администратора" styleClass="title-medium"/>

            <VBox spacing="20" alignment="CENTER" styleClass="form-container" style="-fx-pref-width: 500px;">
                <VBox spacing="15" alignment="CENTER">
                    <Button text="📋 Управление экскурсиями" onAction="#handleExcursions"
                            styleClass="btn-primary" style="-fx-pref-width: 300px; -fx-pref-height: 50px; -fx-font-size: 16px;"/>

                    <Button text="👥 Управление пользователями" onAction="#handleUsers"
                            styleClass="btn-warning" style="-fx-pref-width: 300px; -fx-pref-height: 50px; -fx-font-size: 16px;"/>

                    <Button text="🚪 Выйти из системы" onAction="#handleLogout"
                            styleClass="btn-danger" style="-fx-pref-width: 300px; -fx-pref-height: 50px; -fx-font-size: 16px;"/>
                </VBox>
            </VBox>

            <!-- Статистика -->
            <VBox styleClass="section-container" style="-fx-pref-width: 500px;">
                <Label text="Функционал" styleClass="title-small" style="-fx-padding: 0 0 10 0;"/>
                <VBox spacing="8">
                    <Label text="• Управление экскурсиями: добавление, редактирование, удаление" styleClass="label-info"/>
                    <Label text="• Управление пользователями: блокировка, разблокировка" styleClass="label-info"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>