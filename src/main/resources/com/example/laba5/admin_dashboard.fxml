<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.AdminDashboardController"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #2c3e50;">
            <Label text="Панель администратора" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label fx:id="welcomeLabel" text="Добро пожаловать!" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Функции администратора" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <VBox spacing="10" alignment="CENTER">
                <Button text="Управление экскурсиями" onAction="#handleExcursions"
                        style="-fx-pref-width: 200px; -fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button text="Управление пользователями" onAction="#handleUsers"
                        style="-fx-pref-width: 200px; -fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button text="Выйти" onAction="#handleLogout"
                        style="-fx-pref-width: 200px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>