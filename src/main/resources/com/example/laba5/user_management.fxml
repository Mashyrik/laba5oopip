<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.UserManagementController"
            stylesheets="@styles.css">

    <top>
        <VBox styleClass="header">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary" style="-fx-pref-width: 100px;"/>
                <VBox>
                    <Label text="Управление пользователями" styleClass="header-title"/>
                    <Label text="Блокировка и разблокировка пользователей" styleClass="header-subtitle"/>
                </VBox>
                <Button text="🔄 Обновить" onAction="#handleRefresh" styleClass="btn-primary" style="-fx-pref-width: 100px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 25;">
            <!-- Таблица пользователей -->
            <VBox styleClass="section-container">
                <Label text="👥 Список пользователей" styleClass="title-small" style="-fx-padding: 0 0 15 0;"/>
                <TableView fx:id="usersTable" style="-fx-pref-height: 400px;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="200" text="Логин">
                            <cellValueFactory>
                                <PropertyValueFactory property="username" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120" text="Роль">
                            <cellValueFactory>
                                <PropertyValueFactory property="role" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120" text="Статус"/>
                        <TableColumn prefWidth="200" text="Действия" resizable="false"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Легенда -->
            <VBox styleClass="section-container" style="-fx-pref-width: 600px;">
                <Label text="Информация" styleClass="title-small" style="-fx-padding: 0 0 10 0;"/>
                <VBox spacing="8">
                    <Label text="• Зеленый - пользователь активен" styleClass="label-info"/>
                    <Label text="• Красный - пользователь заблокирован" styleClass="label-info"/>
                    <Label text="• Заблокированные пользователи не могут войти в систему" styleClass="label-info"/>
                    <Label text="• Нельзя заблокировать самого себя" styleClass="label-info"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>