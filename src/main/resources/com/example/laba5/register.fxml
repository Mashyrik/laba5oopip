<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.RegisterController"
            stylesheets="@styles.css"
            prefWidth="1000" prefHeight="700">

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40;" VBox.vgrow="ALWAYS">
            <!-- Заголовок -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="🚗 ТурЭкскурс" styleClass="title-large"/>
                <Label text="Создание новой учетной записи" styleClass="subtitle"/>
            </VBox>

            <!-- Форма регистрации -->
            <VBox alignment="CENTER" spacing="25" styleClass="form-container"
                  style="-fx-pref-width: 450px; -fx-max-width: 450px;">
                <Label text="Регистрация" styleClass="title-small"/>

                <VBox spacing="15" style="-fx-pref-width: 400px;">
                    <!-- Логин -->
                    <VBox spacing="8">
                        <Label text="Логин:" styleClass="label-bold"/>
                        <TextField fx:id="usernameField" styleClass="form-field" promptText="Придумайте логин"/>
                    </VBox>

                    <!-- Пароль -->
                    <VBox spacing="8">
                        <Label text="Пароль:" styleClass="label-bold"/>
                        <PasswordField fx:id="passwordField" styleClass="form-field" promptText="Придумайте пароль"/>
                    </VBox>

                    <!-- Подтверждение пароля -->
                    <VBox spacing="8">
                        <Label text="Подтверждение пароля:" styleClass="label-bold"/>
                        <PasswordField fx:id="confirmPasswordField" styleClass="form-field" promptText="Повторите пароль"/>
                    </VBox>
                </VBox>

                <!-- Кнопки -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="Зарегистрироваться" onAction="#handleRegister" styleClass="btn-success"
                            style="-fx-pref-width: 200px; -fx-pref-height: 45px;"/>
                    <Button text="Назад" onAction="#handleBackToLogin" styleClass="btn-secondary"
                            style="-fx-pref-width: 140px; -fx-pref-height: 45px;"/>
                </HBox>

                <!-- Требования -->
                <VBox spacing="5" style="-fx-pref-width: 400px;">
                    <Label text="Требования:" styleClass="label-bold"/>
                    <Label text="• Логин: минимум 3 символа" styleClass="label-info"/>
                    <Label text="• Пароль: минимум 4 символа" styleClass="label-info"/>
                    <Label text="• Пароли должны совпадать" styleClass="label-info"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>