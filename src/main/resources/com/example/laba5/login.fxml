<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.LoginController"
            stylesheets="@styles.css">

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">
            <!-- Заголовок -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="🚗 ТурЭкскурс" styleClass="title-large"/>
                <Label text="Экскурсионная студия" styleClass="subtitle"/>
            </VBox>

            <!-- Форма входа -->
            <VBox alignment="CENTER" spacing="25" styleClass="form-container" style="-fx-pref-width: 400px;">
                <Label text="Вход в систему" styleClass="title-small"/>

                <VBox spacing="20" style="-fx-pref-width: 350px;">
                    <!-- Поле логина -->
                    <VBox spacing="8">
                        <Label text="Логин:" styleClass="label-bold"/>
                        <TextField fx:id="usernameField" styleClass="form-field" promptText="Введите ваш логин"/>
                    </VBox>

                    <!-- Поле пароля -->
                    <VBox spacing="8">
                        <Label text="Пароль:" styleClass="label-bold"/>
                        <PasswordField fx:id="passwordField" styleClass="form-field" promptText="Введите ваш пароль"/>
                    </VBox>
                </VBox>

                <!-- Кнопки -->
                <VBox spacing="12" alignment="CENTER" style="-fx-pref-width: 350px;">
                    <Button text="Войти" onAction="#handleLogin" styleClass="btn-primary" style="-fx-pref-width: 350px; -fx-pref-height: 45px;"/>
                    <Button text="Зарегистрироваться" onAction="#handleRegister" styleClass="btn-secondary" style="-fx-pref-width: 350px; -fx-pref-height: 45px;"/>
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>