<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.laba5.UserDashboardController"
      alignment="CENTER" spacing="20"
      style="-fx-padding: 40; -fx-background-color: #ecf0f1;">

    <Label fx:id="welcomeLabel" text="Добро пожаловать!"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>

    <Label text="Панель пользователя"
           style="-fx-font-size: 18px; -fx-text-fill: #2c3e50;"/>

    <VBox spacing="10" alignment="CENTER">
        <Button text="Просмотр экскурсий" onAction="#handleViewExcursions"
                style="-fx-pref-width: 200px; -fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="Расчет стоимости" onAction="#handleCalculateCost"
                style="-fx-pref-width: 200px; -fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="Выйти" onAction="#handleLogout"
                style="-fx-pref-width: 200px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </VBox>

</VBox>