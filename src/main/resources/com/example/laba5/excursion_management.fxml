<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.ExcursionManagementController"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <Label text="Управление экскурсиями" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Button text="Назад" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 100px;"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 20; -fx-alignment: TOP_LEFT;">
            <!-- ЛЕВАЯ ЧАСТЬ - Форма добавления экскурсии -->
            <VBox style="-fx-pref-width: 350px;">
                <VBox style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <Label text="Добавить новую экскурсию" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 15 0;"/>

                    <!-- Поле места -->
                    <VBox spacing="5" style="-fx-padding: 0 0 15 0;">
                        <Label text="Место экскурсии:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <TextField fx:id="placeField" promptText="Например: Минск, Брест..."
                                   style="-fx-pref-height: 35px; -fx-background-radius: 8px; -fx-border-radius: 8px;"/>
                    </VBox>

                    <!-- Выбор дня -->
                    <VBox spacing="5" style="-fx-padding: 0 0 15 0;">
                        <Label text="Тип дня:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <ComboBox fx:id="dayComboBox"
                                  style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>
                    </VBox>

                    <!-- Выбор времени -->
                    <VBox spacing="5" style="-fx-padding: 0 0 15 0;">
                        <Label text="Время дня:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <ComboBox fx:id="timeComboBox"
                                  style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>
                    </VBox>

                    <!-- Выбор гида -->
                    <VBox spacing="5" style="-fx-padding: 0 0 20 0;">
                        <Label text="Квалификация гида:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <ComboBox fx:id="guideComboBox"
                                  style="-fx-pref-height: 35px; -fx-background-radius: 8px;"/>
                    </VBox>

                    <!-- Кнопка добавления -->
                    <Button text="➕ Добавить экскурсию" onAction="#handleAddExcursion"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40px; -fx-background-radius: 8px; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>

            <!-- ПРАВАЯ ЧАСТЬ - Таблица экскурсий -->
            <VBox spacing="15" style="-fx-pref-width: 650px;">
                <!-- Таблица с оптимальным использованием пространства -->
                <TableView fx:id="excursionsTable" style="-fx-pref-height: 450px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-table-cell-border-color: transparent;">
                    <columns>
                        <TableColumn prefWidth="140" text="Место" style="-fx-alignment: CENTER;">
                            <cellValueFactory>
                                <PropertyValueFactory property="place" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="110" text="День" style="-fx-alignment: CENTER;">
                            <cellValueFactory>
                                <PropertyValueFactory property="dayType" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="100" text="Время" style="-fx-alignment: CENTER;">
                            <cellValueFactory>
                                <PropertyValueFactory property="timeOfDay" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120" text="Квалификация гида" style="-fx-alignment: CENTER;">
                            <cellValueFactory>
                                <PropertyValueFactory property="guideLevel" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="120" text="Стоимость" style="-fx-alignment: CENTER;">
                            <cellValueFactory>
                                <PropertyValueFactory property="cost" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="80" text="Действия" style="-fx-alignment: CENTER;" resizable="false"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Статистика -->
                <HBox spacing="10" style="-fx-padding: 12px; -fx-background-color: white; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-alignment: center;">
                    <Label text="Всего экскурсий:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="excursionCountLabel" text="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>