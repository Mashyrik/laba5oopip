<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.UserExcursionsController"
            stylesheets="@styles.css">

    <top>
        <VBox styleClass="header">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary" style="-fx-pref-width: 100px;"/>
                <VBox>
                    <Label text="Просмотр экскурсий" styleClass="header-title"/>
                    <Label text="Фильтрация, сортировка и расчет стоимости" styleClass="header-subtitle"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="20" style="-fx-padding: 20; -fx-pref-width: 280px;">
            <!-- Фильтры -->
            <VBox styleClass="form-container">
                <Label text="🔍 Фильтры" styleClass="title-small" style="-fx-padding: 0 0 15 0;"/>

                <VBox spacing="12">
                    <VBox spacing="5">
                        <Label text="День недели:" styleClass="label-bold"/>
                        <ComboBox fx:id="dayFilterComboBox" style="-fx-pref-height: 40px; -fx-background-radius: 8px; -fx-pref-width: 240px;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Квалификация гида:" styleClass="label-bold"/>
                        <ComboBox fx:id="guideFilterComboBox" style="-fx-pref-height: 40px; -fx-background-radius: 8px; -fx-pref-width: 240px;"/>
                    </VBox>
                </VBox>

                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                    <Button text="Применить" onAction="#handleApplyFilters"
                            styleClass="btn-primary" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                    <Button text="Сбросить" onAction="#handleResetFilters"
                            styleClass="btn-secondary" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>

            <!-- Сортировка -->
            <VBox styleClass="form-container">
                <Label text="📊 Сортировка" styleClass="title-small" style="-fx-padding: 0 0 15 0;"/>

                <VBox spacing="8">
                    <Button text="Возрастание" onAction="#handleSortAscending"
                            styleClass="btn-primary" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                    <Button text="Убывание" onAction="#handleSortDescending"
                            styleClass="btn-warning" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                    <Button text="Отмена" onAction="#handleCancelSort"
                            styleClass="btn-secondary" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>

            <!-- Расчет стоимости -->
            <VBox styleClass="form-container">
                <Label text="💰 Расчет стоимости" styleClass="title-small" style="-fx-padding: 0 0 15 0;"/>

                <VBox spacing="10">
                    <Label fx:id="costLabel" text="Выберите экскурсию из таблицы"
                           styleClass="label-info" style="-fx-pref-height: 60px; -fx-wrap-text: true; -fx-pref-width: 240px;"/>

                    <Button text="Рассчитать" onAction="#handleCalculateCost"
                            styleClass="btn-success" style="-fx-pref-width: 240px; -fx-pref-height: 40px; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-alignment: top-left;">
            <Label text="🎯 Доступные экскурсии" styleClass="title-small"/>
            <TableView fx:id="excursionsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="200" text="Место">
                        <cellValueFactory>
                            <PropertyValueFactory property="place" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="День недели">
                        <cellValueFactory>
                            <PropertyValueFactory property="dayType" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Время суток">
                        <cellValueFactory>
                            <PropertyValueFactory property="timeOfDay" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="250" text="Квалификация гида">
                        <cellValueFactory>
                            <PropertyValueFactory property="guideLevel" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>