<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.laba5.UserExcursionsController"
            stylesheets="@styles.css"
            prefWidth="1400" prefHeight="900">

    <top>
        <VBox styleClass="header">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary" style="-fx-pref-width: 100px;"/>
                <VBox>
                    <Label text="Просмотр экскурсий" styleClass="header-title"/>
                    <Label text="Фильтрация, сортировка и расчет стоимости" styleClass="header-subtitle"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="15" style="-fx-padding: 15; -fx-pref-width: 320px; -fx-min-width: 320px; -fx-max-width: 320px;">
            <!-- Фильтры -->
            <VBox styleClass="form-container" VBox.vgrow="NEVER" style="-fx-pref-height: 180px;">
                <Label text="🔍 Фильтры" styleClass="title-small" style="-fx-padding: 0 0 10 0;"/>

                <VBox spacing="8">
                    <VBox spacing="4">
                        <Label text="День недели:" styleClass="label-bold"/>
                        <ComboBox fx:id="dayFilterComboBox" style="-fx-pref-height: 35px; -fx-background-radius: 8px; -fx-pref-width: 290px;"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Квалификация гида:" styleClass="label-bold"/>
                        <ComboBox fx:id="guideFilterComboBox" style="-fx-pref-height: 35px; -fx-background-radius: 8px; -fx-pref-width: 290px;"/>
                    </VBox>
                </VBox>

                <VBox spacing="6" style="-fx-padding: 8 0 0 0;">
                    <Button text="Применить" onAction="#handleApplyFilters"
                            styleClass="btn-primary" style="-fx-pref-width: 290px; -fx-pref-height: 35px; -fx-font-size: 13px;"/>
                    <Button text="Сбросить" onAction="#handleResetFilters"
                            styleClass="btn-secondary" style="-fx-pref-width: 290px; -fx-pref-height: 35px; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>

            <!-- Сортировка -->
            <VBox styleClass="form-container" VBox.vgrow="NEVER" style="-fx-pref-height: 150px;">
                <Label text="📊 Сортировка" styleClass="title-small" style="-fx-padding: 0 0 10 0;"/>

                <VBox spacing="6">
                    <Button text="Возрастание" onAction="#handleSortAscending"
                            styleClass="btn-primary" style="-fx-pref-width: 290px; -fx-pref-height: 35px; -fx-font-size: 13px;"/>
                    <Button text="Убывание" onAction="#handleSortDescending"
                            styleClass="btn-warning" style="-fx-pref-width: 290px; -fx-pref-height: 35px; -fx-font-size: 13px;"/>
                    <Button text="Отмена" onAction="#handleCancelSort"
                            styleClass="btn-secondary" style="-fx-pref-width: 290px; -fx-pref-height: 35px; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>

            <!-- Расчет стоимости -->
            <VBox styleClass="form-container" VBox.vgrow="ALWAYS" style="-fx-pref-height: 200px;">
                <Label text="💰 Расчет стоимости" styleClass="title-small" style="-fx-padding: 0 0 10 0;"/>

                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label fx:id="costLabel" text="Выберите экскурсию из списка"
                           styleClass="label-info" style="-fx-pref-height: 70px; -fx-wrap-text: true; -fx-pref-width: 290px; -fx-background-color: #f8f9fa; -fx-padding: 8px; -fx-border-radius: 5px;"/>

                    <Button text="Рассчитать стоимость" onAction="#handleCalculateCost"
                            styleClass="btn-success" style="-fx-pref-width: 290px; -fx-pref-height: 40px; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
            <Label text="🎯 Доступные экскурсии" styleClass="title-small"/>

            <!-- Контейнер для карточек экскурсий с скроллом -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: transparent;"
                        VBox.vgrow="ALWAYS">
                <FlowPane fx:id="excursionsContainer"
                          hgap="12"
                          vgap="12"
                          style="-fx-padding: 8px; -fx-background-color: transparent;"
                          alignment="TOP_LEFT">
                    <!-- Карточки экскурсий будут добавляться динамически -->
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>